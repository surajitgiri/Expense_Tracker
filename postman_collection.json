    {
      "name": "3. Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (optional)"
                },
                {
                  "key": "limit",
                  "value": "15",
                  "description": "Items per page (optional)"
                },
                {
                  "key": "type",
                  "value": "expense",
                  "disabled": true,
                  "description": "Filter by income or expense"
                },
                {
                  "key": "month",
                  "value": "2026-10",
                  "disabled": true,
                  "description": "Filter by YYYY-MM"
                },
                {
                  "key": "category",
                  "value": "{{categoryId}}",
                  "disabled": true,
                  "description": "Filter by categoryId"
                },
                {
                  "key": "search",
                  "value": "coffee",
                  "disabled": true,
                  "description": "Search descriptions"
                }
              ]
            },
            "description": "List transactions with optional filters and pagination."
          }
        },
        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('transactionId', json.id);",
                  "        console.log('Saved transactionId:', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 450.00,\n  \"type\": \"expense\",\n  \"description\": \"Team lunch\",\n  \"date\": \"2026-10-02T12:00:00.000Z\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"accountId\": \"{{accountId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Create a new income or expense transaction."
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{transactionId}}\",\n  \"amount\": 500.00,\n  \"type\": \"expense\",\n  \"description\": \"Team lunch & drinks\",\n  \"date\": \"2026-10-02T12:00:00.000Z\",\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Update an existing transaction and recalculate account balance."
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?id={{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "id",
                  "value": "{{transactionId}}",
                  "description": "Transaction ID to delete"
                }
              ]
            },
            "description": "Delete a transaction by ID and reverse account balances."
          }
        }
      ]
    },
